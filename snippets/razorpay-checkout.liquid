{% comment %}
  Razorpay Magic Checkout button snippet.
  Razorpay's Shopify app hooks the standard Shopify checkout button/form.
  Keep this as a native checkout form so Magic Checkout can intercept it,
  while Shopify still provides a safe fallback if the app is unavailable.
{% endcomment %}
{% if settings.razorpay_enabled %}
  {% if request.design_mode %}
    <div class="razorpay-checkout-wrap">
      <button type="button" class="btn btn--primary btn--full" disabled>
        <span class="btn-text"><span>{{ settings.razorpay_button_text | default: 'Checkout' }}</span></span>
      </button>
    </div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" class="razorpay-checkout-wrap">
      <button type="submit" name="checkout" id="razorpay-magic-btn" class="btn btn--primary btn--full">
        <span class="btn-text"><span>{{ settings.razorpay_button_text | default: 'Checkout' }}</span></span>
      </button>
    </form>
  {% endif %}
{% endif %}
